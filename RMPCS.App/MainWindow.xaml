<Window x:Class="RMPCS.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RMPCS - PC Toolkit" Icon="Assets/RMPCS.ico" Width="1320" Height="820" MinWidth="1180" MinHeight="720" Background="#F5F7FA" Foreground="#202938" FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged">
 <Window.Resources>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#202938"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="Header" Background="#FFFFFF" CornerRadius="6" Padding="14,13" Margin="0,0,8,6" Width="122"><ContentPresenter ContentSource="Header"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Header" Property="Background" Value="#FBEAF0"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  
  
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal"><Image Source="Assets/RMPCS.png" Width="46" Height="46" Margin="0,0,14,0"/><StackPanel><TextBlock Text="RMPCS" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="PC maintenance, on your terms." FontSize="12" Foreground="#596678" Margin="0,4,0,0"/></StackPanel></StackPanel>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="AdminStatus" HorizontalAlignment="Right" Margin="0,0,10,8" Foreground="#596678"/><StackPanel Orientation="Horizontal"><Button Content="Hide to tray" Click="Tray_Click" Padding="12,8"/><Button x:Name="ElevateButton" Content="Run as administrator" Click="Elevate_Click" Padding="12,8"/></StackPanel></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#EAF0F6" CornerRadius="8" Padding="12" Margin="0,16,0,14"><TextBlock x:Name="TrayStatus" Text="Check health, review cleanup, and run only the tasks you choose." TextWrapping="Wrap" Foreground="#4F5D70"/></Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="610"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TabControl TabStripPlacement="Left" x:Name="MainTabs" Background="#FFFFFF" BorderThickness="0" Padding="16">
    <TabItem Header="Health"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HealthPanel">
     <TextBlock Text="HEALTH SNAPSHOT" Foreground="#BE2B4E" FontWeight="Bold"/>
     <TextBlock Text="A quick view of CPU, memory, storage, restart indicators and recent Windows errors. Results appear in Activity." TextWrapping="Wrap" Foreground="#596678" Margin="0,10,0,15"/>
     <Button Content="Run health scan" Click="HealthScan_Click" Margin="0,0,0,12"/>
     <TextBlock Text="The scan changes no settings. It does not measure physical disk health or prove a crash's cause. Unavailable checks are reported individually. Export the report if you want to save it." TextWrapping="Wrap" Foreground="#596678"/>
     <Border Background="#F3F6FA" CornerRadius="8" Padding="16" Margin="0,24,0,0"><StackPanel><TextBlock Text="Quiet when you need it" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Close or minimize to keep RMPCS in your tray. Click its icon to return. Enable sign-in startup in Automation; maintenance schedules stay separate." TextWrapping="Wrap" Foreground="#596678" Margin="0,8,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Maintenance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <StackPanel x:Name="TaskPanel">
      <WrapPanel Margin="0,0,0,12"><Button Content="Recommended care" Click="SelectCare_Click" Padding="12,9"/><Button Content="Select full batch" Click="SelectBatch_Click" Padding="12,9"/></WrapPanel>
      <CheckBox x:Name="UserTemp" Content="Clean my temporary files" IsChecked="True"/>
      <CheckBox x:Name="SystemTemp" Content="Clean Windows temporary files"/>
      <TextBlock Text="Cleanup age (applies to selected file cleanup tasks)" Foreground="#596678" FontSize="12"/>
      <ComboBox x:Name="Age" SelectedIndex="2"><ComboBoxItem Content="All eligible ages - closest to original batch"/><ComboBoxItem Content="Older than 1 day"/><ComboBoxItem Content="Older than 7 days - recommended"/><ComboBoxItem Content="Older than 30 days"/></ComboBox>
      <Expander Header="Additional cleanup" Foreground="#596678" Margin="0,8,0,8"><StackPanel>
      <CheckBox x:Name="Thumbnails" Content="Thumbnail cache files"/>
      <CheckBox x:Name="ErrorArchives" Content="Archived Windows error reports"/>
      <CheckBox x:Name="CrashDumps" Content="Application crash dumps (.dmp)"/>
      <CheckBox x:Name="RecycleBin" Content="Empty my Recycle Bins (all ages)"/>
      <TextBlock Text="Error reports and dumps can help diagnose crashes. Recycle Bin emptying is permanent and ignores the age filter. New categories are excluded from presets and schedules." TextWrapping="Wrap" Foreground="#596678" Margin="0,3,0,10"/>
      </StackPanel></Expander>
      <CheckBox x:Name="Dns" Content="Flush DNS cache"/><CheckBox x:Name="Dism" Content="Repair Windows image (DISM)"/><CheckBox x:Name="Sfc" Content="Check system files (SFC)"/>
      <Expander x:Name="AdvancedOptions" Header="Advanced / original batch" Foreground="#BE2B4E" Margin="0,12,0,6"><StackPanel>
      <CheckBox x:Name="Prefetch" Content="Clear Prefetch application cache (.pf)"/>
      <TextBlock Text="Windows recreates this cache. App launches may be slower afterward. Layout metadata is preserved." TextWrapping="Wrap" Foreground="#596678" Margin="22,0,0,4"/>
      <CheckBox x:Name="WindowsLogs" Content="Clean files under Windows Logs"/>
      <TextBlock Text="Permanently removes eligible diagnostic files, not Event Viewer channels. Locked/protected files are skipped." TextWrapping="Wrap" Foreground="#596678" Margin="22,0,0,4"/>
      <CheckBox x:Name="SearchIndex" Content="Reset and rebuild Windows Search index"/>
      <TextBlock Text="Resets the catalog through Windows Search. Search can be incomplete while Windows rebuilds in the background." TextWrapping="Wrap" Foreground="#596678" Margin="22,0,0,4"/>
      <CheckBox x:Name="Dhcp" Content="Release and renew DHCP leases"/>
      <TextBlock Text="Interrupts internet, VPNs and remote connections. Reconnection is not guaranteed." TextWrapping="Wrap" Foreground="#596678" Margin="22,0,0,4"/>
      <CheckBox x:Name="RebootAfter" Content="Restart after successful completion"/>
      <ComboBox x:Name="RebootDelay" SelectedIndex="1"><ComboBoxItem Content="10-second countdown (original batch)"/><ComboBoxItem Content="60-second countdown"/><ComboBoxItem Content="5-minute countdown"/></ComboBox>
      </StackPanel></Expander>
     </StackPanel>
     <Button x:Name="PreviewButton" Content="Preview selected file cleanup" Click="Preview_Click" Margin="0,12,0,8"/>
     <DataGrid x:Name="PreviewRows" Visibility="Collapsed" Height="155" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Foreground="#202938" Background="White" Margin="0,0,0,10">
      <DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Area}" Width="*"/><DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="55"/><DataGridTextColumn Header="MB" Binding="{Binding Megabytes}" Width="65"/><DataGridTextColumn Header="Skipped" Binding="{Binding Skipped}" Width="60"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="Files bypass the Recycle Bin. Locked files, protected files, links and hard-linked files are skipped. No folder deletion or ACL changes." TextWrapping="Wrap" Foreground="#596678"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Automation"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="START AT SIGN-IN" FontWeight="Bold" Foreground="#596678"/>
     <TextBlock Text="Start quietly in the system tray after sign-in, with administrator rights. Opening the app does not run maintenance." TextWrapping="Wrap" Foreground="#596678" Margin="0,8,0,12"/>
     <TextBlock x:Name="StartupStatus" Text="Status not loaded" Margin="0,0,0,12"/>
     <StackPanel x:Name="AutomationPanel">
      <WrapPanel><Button Content="Enable startup to tray" Click="StartupOn_Click" Padding="12,10"/><Button Content="Disable startup" Click="StartupOff_Click" Padding="12,10"/></WrapPanel>
      <TextBlock Text="AUTOMATIC MAINTENANCE" FontWeight="Bold" Foreground="#596678" Margin="0,24,0,10"/>
      <TextBlock Text="Frequency"/><ComboBox x:Name="Frequency" SelectedIndex="1"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/></ComboBox>
      <TextBlock Text="Day (weekly schedule)"/><ComboBox x:Name="WeekDay" SelectedIndex="0"><ComboBoxItem Content="Sunday"/><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/><ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/><ComboBoxItem Content="Saturday"/></ComboBox>
      <TextBlock Text="Local PC time (24-hour HH:mm)"/><TextBox x:Name="ScheduleTime" Text="19:00" Margin="0,6,0,12"/>
      <TextBlock Text="Profile"/><ComboBox x:Name="ScheduleProfile" SelectedIndex="0"><ComboBoxItem Content="Light: 7-day temp cleanup + DNS"/><ComboBoxItem Content="Repair: light care + DISM + SFC"/></ComboBox>
      <CheckBox x:Name="IdleOnly" Content="Start only when idle for 10 minutes" IsChecked="True"/><CheckBox x:Name="AcOnly" Content="Start only on AC power" IsChecked="True"/>
      <TextBlock Text="Runs while this Windows user is signed in. Missed runs may start later. Does not wake the PC. An active repair is allowed to finish if you resume work or unplug power." TextWrapping="Wrap" Foreground="#596678" Margin="0,8,0,14"/>
      <WrapPanel><Button Content="Save schedule" Click="SaveSchedule_Click" Padding="12,10"/><Button Content="Remove schedule" Click="RemoveSchedule_Click" Padding="12,10"/></WrapPanel>
     </StackPanel>
     <TextBlock x:Name="ScheduleStatus" Text="Status not loaded" TextWrapping="Wrap" Margin="0,14,0,12"/>
     <Button Content="Refresh status" Click="Refresh_Click" Margin="0,0,0,12"/>
     <TextBlock Text="Install RMPCS before enabling automation. Both features are off by default. No passwords are stored. Scheduled profiles exclude Prefetch, Windows logs, index resets, DHCP release and restart." TextWrapping="Wrap" Foreground="#596678"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Startup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="StartupAppsPanel">
     <TextBlock Text="STARTUP APP MANAGER" Foreground="#BE2B4E" FontWeight="Bold"/>
     <TextBlock Text="Review common Run registry entries for this Windows identity and the machine. Select an entry to disable it with a protected backup, or restore an entry disabled by RMPCS. Commands are displayed, never launched." TextWrapping="Wrap" Foreground="#596678" Margin="0,10,0,12"/>
     <Button Content="Refresh startup entries" Click="StartupAppsRefresh_Click" Margin="0,0,0,10"/>
     <DataGrid x:Name="StartupEntries" Height="220" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Foreground="#202938" Background="White" SelectionChanged="StartupSelection_Changed">
      <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="85"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/></DataGrid.Columns>
     </DataGrid>
     <TextBox x:Name="StartupCommand" IsReadOnly="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,10,0,10"/>
     <WrapPanel><Button x:Name="DisableStartupApp" Content="Disable selected" Click="DisableStartupApp_Click" Padding="12,10"/><Button x:Name="RestoreStartupApp" Content="Restore selected" Click="RestoreStartupApp_Click" Padding="12,10"/></WrapPanel>
     <TextBlock Text="Administrator rights are required for changes. Existing live values are never overwritten on restore. Task Manager approvals, startup folders, services, scheduled tasks and packaged startup tasks are outside this manager's scope. A present Run entry may still be blocked by Windows or the app. Use Automation for RMPCS's own sign-in startup." TextWrapping="Wrap" Foreground="#596678" Margin="0,14,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="History"><StackPanel x:Name="HistoryPanel">
     <TextBlock Text="SAVED RUNS" FontWeight="Bold" Foreground="#596678"/><TextBlock Text="Manual and scheduled runs save local activity logs. The list shows the latest 30; files older than 30 days are eligible for log retention cleanup." TextWrapping="Wrap" Foreground="#596678" Margin="0,10,0,10"/>
     <ComboBox x:Name="HistoryFiles" DisplayMemberPath="Name"/><Button Content="Load selected log" Click="LoadHistory_Click" Margin="0,0,0,10"/><Button Content="Refresh history" Click="HistoryRefresh_Click" Margin="0,0,0,10"/>
     <TextBlock Text="ABOUT RMPCS" FontWeight="Bold" Foreground="#596678" Margin="0,24,0,10"/><TextBlock Text="Written by Wade. Based on Wade's Multi-Purpose Cleanup Script (WMPCS) 0.3b.&#10;&#10;Discord / Support: discord.beer/thelocker&#10;&#10;Maintenance does not guarantee higher FPS or resolve hardware/driver faults. Review command output for repair findings." TextWrapping="Wrap" Foreground="#596678"/>
    </StackPanel></TabItem>
   </TabControl>
   <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Padding="18"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="ACTIVITY" FontWeight="Bold" Foreground="#596678"/><TextBlock x:Name="Status" Grid.Row="1" Text="Ready when you are." FontSize="19" Margin="0,12,0,15" TextWrapping="Wrap"/>
    <TextBox x:Name="Activity" Grid.Row="2" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="3" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="4" Foreground="#BE2B4E" Background="#E3E8EF" Visibility="Collapsed"/><TextBlock Text="Repairs finish before the queue stops. Overlapping maintenance sessions are blocked." TextWrapping="Wrap" Foreground="#596678" Margin="0,10,0,0"/></StackPanel>
   </Grid></Border>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="RunButton" Content="Run selected tasks" Background="#BE2B4E" Foreground="White" Click="Run_Click"/><Button x:Name="CareButton" Content="Run recommended care" Click="Care_Click"/><Button x:Name="StopButton" Content="Stop after current task" IsEnabled="False" Click="Stop_Click"/><Button Content="Export log" Click="Export_Click"/><Button x:Name="AbortRestartButton" Content="Cancel restart" Click="AbortRestart_Click"/><Button Content="Exit" Click="Exit_Click"/></WrapPanel>
 </Grid>
</Window>
