<Window x:Class="RMPCS.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="RMPCS - Rusty's PC Toolkit" Icon="Assets/RMPCS.ico" Width="1320" Height="820" MinWidth="960" MinHeight="620" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged">
 <Window.Resources>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
   <Border x:Name="Header" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,8,6" Width="122"><ContentPresenter ContentSource="Header"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectedTextBrush}"/><Setter TargetName="Header" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
  
  
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal"><Image Source="Assets/RMPCS.png" Width="46" Height="46" Margin="0,0,14,0"/><StackPanel><TextBlock Text="RMPCS" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Rusty's PC Toolkit" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></StackPanel>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="AdminStatus" HorizontalAlignment="Right" Margin="0,0,10,8" Foreground="{DynamicResource MutedBrush}"/><StackPanel Orientation="Horizontal"><Button Content="Updates" Click="ShowUpdates_Click" Padding="12,8"/><Button Content="Hide to tray" Click="Tray_Click" Padding="12,8"/><Button x:Name="ElevateButton" Content="Run as administrator" Click="Elevate_Click" Padding="12,8"/></StackPanel></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="12" Margin="0,16,0,14"><TextBlock x:Name="TrayStatus" Text="Check health, review cleanup, and run only the tasks you choose." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TabControl TabStripPlacement="Left" x:Name="MainTabs" SelectionChanged="MainTabs_Changed" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="16">
    <TabItem Header="Overview"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="HealthPanel">
     <TextBlock Text="Start with a quick check" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="Start with a check, review what needs attention, then choose what to do. Nothing runs automatically when you open RMPCS." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,22"/>
     <Border Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="16"><StackPanel>
      <TextBlock Text="1  Check your PC" FontSize="17" FontWeight="SemiBold"/>
      <TextBlock Text="See memory, storage and recent Windows errors. This check changes no settings." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,14"/>
      <Button Content="Check my PC" Style="{StaticResource PrimaryButton}" Click="HealthScan_Click"/>
     </StackPanel></Border>
     <TextBlock Text="2  Review maintenance" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,8"/>
     <TextBlock Text="Review recommended tasks before you run them. Cleanup permanently deletes eligible files; Windows repairs can take a while." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     
     <Button x:Name="CareButton" Content="Review recommended care" Click="Care_Click"/>
     <TextBlock Text="3  Make Windows startup lighter" FontSize="17" FontWeight="SemiBold" Margin="0,22,0,8"/>
     <TextBlock Text="Review apps that have common Windows startup entries. Turn off entries you recognize; RMPCS keeps a backup for restoring them." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <Button Content="Manage startup apps" Click="ShowStartup_Click"/>
     <TextBlock Text="Need a hand? Help explains each tool. Results appear on the right." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,20,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Maintenance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <StackPanel x:Name="TaskPanel">
      <WrapPanel Margin="0,0,0,12"><Button Content="Recommended care" Click="SelectCare_Click" Padding="12,9"/><Button Content="Select all original tools" Click="SelectBatch_Click" Padding="12,9"/></WrapPanel>
      <CheckBox x:Name="UserTemp" Content="Clean my temporary files" IsChecked="True"/>
      <CheckBox x:Name="SystemTemp" Content="Clean Windows temporary files (all users)"/>
      <TextBlock Text="Cleanup age (applies to selected file cleanup tasks)" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
      <ComboBox x:Name="Age" SelectedIndex="2"><ComboBoxItem Content="All eligible ages - closest to original batch"/><ComboBoxItem Content="Older than 1 day"/><ComboBoxItem Content="Older than 7 days - recommended"/><ComboBoxItem Content="Older than 30 days"/></ComboBox>
      <Expander Header="Additional cleanup" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,8"><StackPanel>
      <CheckBox x:Name="Thumbnails" Content="Thumbnail cache files"/>
      <CheckBox x:Name="ErrorArchives" Content="Archived Windows error reports"/>
      <CheckBox x:Name="CrashDumps" Content="Application crash dumps (.dmp)"/>
      <CheckBox x:Name="RecycleBin" Content="Empty my Recycle Bins (all ages)"/>
      <TextBlock Text="Error reports and dumps can help diagnose crashes. Recycle Bin emptying is permanent and ignores the age filter. New categories are excluded from presets and schedules." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10"/>
      </StackPanel></Expander>
      <CheckBox x:Name="Dns" Content="Flush DNS cache"/><CheckBox x:Name="Dism" Content="Repair Windows components (DISM)"/><CheckBox x:Name="Sfc" Content="Check Windows system files (SFC)"/>
      <Expander x:Name="AdvancedOptions" Header="Advanced tools - review before use" Foreground="{DynamicResource AccentTextBrush}" Margin="0,12,0,6"><StackPanel>
      <CheckBox x:Name="Prefetch" Content="Clear Prefetch application cache (.pf)"/>
      <TextBlock Text="Windows recreates this cache. App launches may be slower afterward. Layout metadata is preserved." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,4"/>
      <CheckBox x:Name="WindowsLogs" Content="Clean files under Windows Logs"/>
      <TextBlock Text="Permanently removes eligible diagnostic files, not Event Viewer channels. Locked/protected files are skipped." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,4"/>
      <CheckBox x:Name="SearchIndex" Content="Reset and rebuild Windows Search index"/>
      <TextBlock Text="Resets the catalog through Windows Search. Search can be incomplete while Windows rebuilds in the background." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,4"/>
      <CheckBox x:Name="Dhcp" Content="Release and renew DHCP leases"/>
      <TextBlock Text="Interrupts internet, VPNs and remote connections. Reconnection is not guaranteed." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="22,0,0,4"/>
      <CheckBox x:Name="RebootAfter" Content="Restart after successful completion"/>
      <ComboBox x:Name="RebootDelay" SelectedIndex="1"><ComboBoxItem Content="10-second countdown (original batch)"/><ComboBoxItem Content="60-second countdown"/><ComboBoxItem Content="5-minute countdown"/></ComboBox>
      <Button x:Name="AbortRestartButton" Content="Cancel a pending Windows restart" Click="AbortRestart_Click" Margin="0,8,0,8"/>
      </StackPanel></Expander>
     </StackPanel>
     <Button x:Name="PreviewButton" Content="Preview selected file cleanup" Click="Preview_Click" Margin="0,12,0,8"/>
     <DataGrid x:Name="PreviewRows" Visibility="Collapsed" Height="155" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,10">
      <DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Area}" Width="*"/><DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="55"/><DataGridTextColumn Header="MB" Binding="{Binding Megabytes}" Width="65"/><DataGridTextColumn Header="Skipped" Binding="{Binding Skipped}" Width="60"/></DataGrid.Columns>
     </DataGrid>
     <TextBlock Text="Files bypass the Recycle Bin. Locked files, protected files, links and hard-linked files are skipped. No folder deletion or ACL changes." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Schedules"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="START AT SIGN-IN" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="Start quietly in the system tray after sign-in, with administrator rights. Opening the app does not run maintenance." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,12"/>
     <TextBlock x:Name="StartupStatus" Text="Status not loaded" Margin="0,0,0,12"/>
     <StackPanel x:Name="AutomationPanel">
      <CheckBox x:Name="AutostartSwitch" Style="{StaticResource SettingSwitch}" Content="Open RMPCS in the tray when I sign in" Click="AutostartToggle_Click" ToolTip="Requires the installed edition and administrator rights"/>
      <TextBlock Text="AUTOMATIC MAINTENANCE" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,24,0,10"/>
      <CheckBox x:Name="ScheduleEnabledSwitch" Style="{StaticResource SettingSwitch}" Content="Run automatic maintenance" Click="ScheduleEnabledToggle_Click"/>
      <TextBlock Text="Set a time and choose your conditions, then save to enable the schedule. Turning it off removes the saved maintenance task." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/>
      <TextBlock Text="Frequency"/><ComboBox x:Name="Frequency" SelectedIndex="1"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/></ComboBox>
      <TextBlock Text="Day (weekly schedule)"/><ComboBox x:Name="WeekDay" SelectedIndex="0"><ComboBoxItem Content="Sunday"/><ComboBoxItem Content="Monday"/><ComboBoxItem Content="Tuesday"/><ComboBoxItem Content="Wednesday"/><ComboBoxItem Content="Thursday"/><ComboBoxItem Content="Friday"/><ComboBoxItem Content="Saturday"/></ComboBox>
      <TextBlock Text="Local PC time (24-hour HH:mm)"/><TextBox x:Name="ScheduleTime" Text="19:00" Margin="0,6,0,12"/>
      <TextBlock Text="Profile"/><ComboBox x:Name="ScheduleProfile" SelectedIndex="0"><ComboBoxItem Content="Light: 7-day temp cleanup + DNS"/><ComboBoxItem Content="Repair: light care + DISM + SFC"/></ComboBox>
      <TextBlock Text="Allowed start window"/><ComboBox x:Name="StartWindowChoice" SelectedIndex="0"><ComboBoxItem Content="Off - allow late starts"/><ComboBoxItem Content="1 hour after scheduled time"/><ComboBoxItem Content="2 hours after scheduled time"/><ComboBoxItem Content="4 hours after scheduled time"/></ComboBox>
      <TextBlock Text="Defer while busy (best-effort signals)"/><ComboBox x:Name="WorkloadDeferChoice" SelectedIndex="0"><ComboBoxItem Content="Off - existing idle/AC rules only"/><ComboBoxItem Content="Wait up to 15 minutes, then skip"/><ComboBoxItem Content="Wait up to 30 minutes, then skip"/><ComboBoxItem Content="Wait up to 60 minutes, then skip"/></ComboBox>
      <TextBlock Text="Checks full-screen/presentation, active microphone sessions, CPU, RAM and network traffic. Unknown signals defer. These guards only decide when to start; active repairs finish normally." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/>
      <CheckBox Style="{StaticResource SettingSwitch}" x:Name="IdleOnly" Content="Start only when idle for 10 minutes" IsChecked="True"/><CheckBox Style="{StaticResource SettingSwitch}" x:Name="AcOnly" Content="Start only on AC power" IsChecked="True"/>
      <TextBlock Text="Runs while this Windows user is signed in. Missed runs may start later. Does not wake the PC. An active repair is allowed to finish if you resume work or unplug power." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,14"/>
      <WrapPanel><Button Content="Save &amp; enable schedule" Click="SaveSchedule_Click" Padding="12,10"/></WrapPanel>
     </StackPanel>
     <TextBlock x:Name="ScheduleStatus" Text="Status not loaded" TextWrapping="Wrap" Margin="0,14,0,12"/>
     <Button Content="Refresh status" Click="Refresh_Click" Margin="0,0,0,12"/>
     <TextBlock Text="Install RMPCS before enabling automation. Both features are off by default. No passwords are stored. Scheduled profiles exclude Prefetch, Windows logs, index resets, DHCP release and restart." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Startup apps"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="StartupAppsPanel">
     <TextBlock Text="STARTUP APP MANAGER" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
     <TextBlock Text="Turn common Windows startup entries on or off. Turning one off keeps a protected backup. Changes affect the next sign-in; currently running apps are left alone." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,12"/>
     <Button Content="Refresh startup entries" Click="StartupAppsRefresh_Click" Margin="0,0,0,10"/>
     <TextBlock x:Name="StartupListStatus" Text="Refresh to see startup entries. Switch changes ask for confirmation." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <DataGrid x:Name="StartupEntries" Height="260" RowHeight="60" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="StartupSelection_Changed">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="App / entry" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="8,5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ScopeLabel}" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Startup entry" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource SettingSwitch}" Content="{Binding SwitchLabel}" IsEnabled="{Binding CanChangeStartup,RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding Enabled,Mode=OneWay}" Click="StartupToggle_Click" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding State}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridCell}}" Margin="3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
     <Expander Header="Selected entry details" Margin="0,12,0,12"><TextBox x:Name="StartupCommand" IsReadOnly="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto"/></Expander>
     <Expander Header="How startup switches work"><TextBlock Text="Administrator rights are required for changes. Existing live values are never overwritten on restore. Task Manager approvals, startup folders, services, scheduled tasks and packaged startup tasks are outside this manager's scope. A present Run entry may still be blocked by Windows or the app. Use Automation for RMPCS's own sign-in startup." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0"/></Expander>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="History"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel x:Name="HistoryPanel">
     <TextBlock Text="SAVED RUNS" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Manual and scheduled runs save local activity logs. The list shows the latest 30; files older than 30 days are eligible for log retention cleanup." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,10"/>
     <ComboBox x:Name="HistoryFiles" DisplayMemberPath="Name"/><Button Content="Load selected log" Click="LoadHistory_Click" Margin="0,0,0,10"/><Button Content="Refresh history" Click="HistoryRefresh_Click" Margin="0,0,0,10"/>
     <WrapPanel Margin="0,4,0,10"><Button Content="Archive selected log" Click="ArchiveSelected_Click"/><Button Content="Archive recent logs" Click="ArchiveRecent_Click"/></WrapPanel>
     <TextBlock Text="Archives keep originals and include only saved RMPCS run logs. Private paths/output may be present. Review before sharing; ZIP files are not encrypted or uploaded." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
     <Button Content="Export current activity text" Click="Export_Click" Margin="0,0,0,10"/>
     <Button Content="Clear activity view" Click="ClearActivity_Click" Margin="0,8,0,10"/>
     <TextBlock Text="Saved logs can contain local paths and command output. Review them before sharing. Search Help for support and troubleshooting." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Settings"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel x:Name="SettingsPanel">
     <TextBlock Text="SETTINGS" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
     <TextBlock x:Name="VersionLabel" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,16" TextWrapping="Wrap"/>
     <TextBlock Text="APPEARANCE" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="Choose a look that is comfortable to read. Appearance previews immediately; Save appearance keeps it." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,10"/>
     <TextBlock Text="App theme"/><ComboBox x:Name="ThemeModeChoice" SelectionChanged="ThemeChoice_Changed"/>
     <TextBlock Text="Accent color"/><ComboBox x:Name="AccentChoice" SelectionChanged="ThemeChoice_Changed"/>
     <Expander Header="Custom accent color" Margin="0,0,0,10"><StackPanel>
      <TextBlock Text="HEX (#RRGGBB)"/><TextBox x:Name="CustomAccentHex" MaxLength="7" TextChanged="CustomHex_Changed" Margin="0,6,0,10"/>
      <TextBlock Text="RGB (0-255)"/><UniformGrid Columns="3" Margin="0,6,0,10"><TextBox x:Name="AccentRed" MaxLength="3" TextChanged="CustomRgb_Changed" AutomationProperties.Name="Red"/><TextBox x:Name="AccentGreen" MaxLength="3" TextChanged="CustomRgb_Changed" AutomationProperties.Name="Green"/><TextBox x:Name="AccentBlue" MaxLength="3" TextChanged="CustomRgb_Changed" AutomationProperties.Name="Blue"/></UniformGrid>
     </StackPanel></Expander>
     <WrapPanel Margin="0,0,0,10"><Button Content="Save appearance" Style="{StaticResource PrimaryButton}" Click="SaveAppearance_Click"/><Button Content="Discard preview" Click="DiscardTheme_Click"/></WrapPanel>
     <TextBlock x:Name="ThemeStatus" Text="Windows High Contrast takes priority over custom colors." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,20"/>
     <TextBlock Text="WINDOW &amp; TRAY" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="Use Save preferences below to apply these settings." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,8"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="CloseToTrayChoice" Content="Close the window to the system tray"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="MinimizeToTrayChoice" Content="Minimize to the system tray"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="TrayNotificationsChoice" Content="Show the first-hide tray reminder"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="CompletionNotificationsChoice" Content="Notify when maintenance finishes or needs review"/>
     <TextBlock Text="Opt-in notices require this app's tray icon in the same Windows sign-in session. Scheduled notices are informational; verify results in History. Windows notification settings may suppress them." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,10"/>
     <TextBlock Text="Exit always closes the app when no task is active. If the tray is unavailable, closing exits normally." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,14"/>
     <TextBlock Text="Open the app on"/><ComboBox x:Name="StartPageChoice"/>
     <TextBlock Text="Activity text size"/><ComboBox x:Name="ActivitySizeChoice"/>
     <TextBlock Text="Default age for manual file cleanup"/><ComboBox x:Name="DefaultAgeChoice"><ComboBoxItem Content="Older than 1 day"/><ComboBoxItem Content="Older than 7 days"/><ComboBoxItem Content="Older than 30 days"/></ComboBox>
     <TextBlock Text="Scheduled profiles keep their fixed seven-day cutoff. Saved preferences never start maintenance." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="RestoreBeforeRepairChoice" Content="Request a restore point before manual Windows repairs"/>
     <TextBlock Text="Applies to DISM, SFC and Search resets. If verification fails, you decide whether to continue. Excludes unattended runs and cleanup-only runs. System Restore is not a backup of deleted files." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,16"/>
     <TextBlock x:Name="UpdatesHeading" Text="GITHUB UPDATES" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="AutoUpdatesChoice" Content="Check for updates when RMPCS starts"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="PreviewUpdatesChoice" Content="Include preview / prerelease builds"/>
     <TextBlock Text="Automatic checks are off by default and run at most once every 24 hours. Current RMPCS releases are previews. Checks contact api.github.com without credentials; no PC reports or logs are sent. Updates are never downloaded or installed automatically." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12"/>
     <WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click"/><Button Content="All releases" Click="Releases_Click"/></WrapPanel>
     <TextBlock x:Name="UpdateStatus" Text="Not checked this session." TextWrapping="Wrap" Margin="0,12,0,10"/>
     <Button x:Name="OpenUpdateButton" Content="Open matching release" IsEnabled="False" Click="OpenUpdate_Click" Margin="0,0,0,10"/>
     <Expander Header="Release notes (plain text)" Foreground="{DynamicResource MutedBrush}"><TextBox x:Name="UpdateNotes" IsReadOnly="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Expander>
     <TextBlock Text="INSTALLATION &amp; AUTOMATION" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,22,0,10"/>
     <TextBlock x:Name="InstallModeLabel" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
     <CheckBox Style="{StaticResource SettingSwitch}" x:Name="InstalledAdminChoice" Content="Always request administrator access"/>
     <Button x:Name="ApplyAdminPreference" Content="Apply administrator preference" Click="ApplyAdminPreference_Click" Margin="0,0,0,10"/>
     <TextBlock Text="Requires an administrator session in the installed edition. This is separate from general preferences and applies across Windows users. Windows UAC remains active." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <Button Content="Manage startup &amp; maintenance schedules" Click="AutomationSettings_Click" Margin="0,0,0,18"/>
     <WrapPanel><Button Content="Save preferences" Click="SavePreferences_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"/><Button Content="Reset interface defaults" Click="ResetPreferences_Click"/></WrapPanel>
     <TextBlock x:Name="PreferencesStatus" Text="Preferences are saved for this Windows identity. Use Save to apply changes." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Help"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
     <TextBlock Text="HELP &amp; ABOUT" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
     <TextBlock Text="Rusty's PC Toolkit" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,6"/>
     <TextBlock Text="Search practical guidance, task explanations and troubleshooting. Help works offline. F1 opens Help; Ctrl+, opens Settings." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
     <TextBlock Text="Search help" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
     <TextBox x:Name="HelpSearch" MaxLength="200" AutomationProperties.Name="Search help" ToolTip="Search topics, such as updates, DNS or tray" TextChanged="HelpSearch_Changed" Margin="0,0,0,10"/>
     <ListBox x:Name="HelpResults" DisplayMemberPath="Title" SelectionChanged="HelpSelection_Changed" Height="135" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" Padding="6"/>
     <TextBox x:Name="HelpBody" IsReadOnly="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" Margin="0,10,0,16"/>
     <WrapPanel><Button Content="RMPCS on GitHub" Click="Project_Click"/><Button Content="Report an issue" Click="Issues_Click"/><Button Content="Discord support" Click="Discord_Click"/></WrapPanel>
     <TextBlock Text="LOOTDROP FOR WINDOWS" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,22,0,8"/>
     <TextBlock Text="Discover free-game offers and track a local wishlist and claimed collection. LootDrop opens official store links in your browser and does not collect store passwords or claim games automatically." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
     <Button Content="LootDrop on GitHub" Click="LootDrop_Click"/>
     <TextBlock Text="SUPPORT SUMMARY" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,22,0,8"/>
     <TextBlock Text="Review before copying. This summary excludes usernames, paths, startup commands, health reports and logs." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
     <TextBox x:Name="SupportSummary" IsReadOnly="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto"/>
     <Button Content="Copy support summary" Click="CopySupport_Click" Margin="0,10,0,10"/>
     <TextBlock Text="An unsigned Degenerates Inc. development app, based on the original WMPCS script. Review command output; maintenance cannot guarantee higher FPS or resolve hardware faults." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Diagnostics"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="DiagnosticsPanel">
     <TextBlock Text="CRASH &amp; STABILITY REPORT" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
     <TextBlock Text="Summarize recent crashes, unexpected shutdowns and recurring System/Application errors. Metadata only: times, sources and event IDs. No event messages are collected." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,10"/>
     <ComboBox x:Name="StabilityPeriod" SelectedIndex="1"><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="Last 30 days"/></ComboBox>
     <Button Content="Read stability report" Click="StabilityReport_Click"/>
     <TextBlock Text="NETWORK DIAGNOSTICS" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" Margin="0,20,0,8"/>
     <TextBlock Text="Check DNS and HTTPS to a fixed public host, plus five gateway pings for latency/loss. Contacts the selected host only when you click Run. No network settings are changed." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
     <ComboBox x:Name="NetworkTarget" SelectedIndex="0"><ComboBoxItem Content="Microsoft (www.microsoft.com)"/><ComboBoxItem Content="GitHub (github.com)"/></ComboBox>
     <WrapPanel><Button Content="Run network tests" Click="NetworkReport_Click"/><Button Content="Use result as baseline" Click="NetworkBaseline_Click"/></WrapPanel>
     <TextBlock x:Name="DiagnosticStatus" Text="Reports appear in Activity. Baselines and the last report stay in memory until you close RMPCS." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,10"/>

     <Button Content="Export last diagnostic report" Click="DiagnosticExport_Click" Margin="0,10,0,0"/>
     <TextBlock Text="Review before sharing. Reports may include private gateway addresses. Short samples do not establish a cause or prove that a repair helped." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Recovery"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProtectionPanel">
     <TextBlock Text="RESTORE POINTS" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
     <TextBlock Text="Ask Windows to create a restore point and verify that a new matching entry exists. Administrator access and available System Protection are required." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,12"/>
     <Button x:Name="CreateRestoreButton" Content="Create &amp; verify restore point" Click="CreateRestore_Click"/>
     <TextBlock Text="Windows may limit creation frequency. RMPCS reports a skipped/unavailable request and never enables protection, changes its frequency or restores Windows automatically. Restore points do not recover permanently deleted personal files. You can opt in to pre-repair creation in Settings." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,18"/>
     <TextBlock Text="UNDO RMPCS PREFERENCES" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock Text="Undo the most recent saved interface/tray/update/repair preference change for this Windows identity. Later conflicting changes prevent undo. This does not undo file deletion, repairs, schedules or third-party settings." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,12"/>
     <Button Content="Undo last interface preference change" Click="UndoInterface_Click"/>
     <Button x:Name="UndoAdminButton" Content="Undo last administrator preference change" Click="UndoAdmin_Click"/>
     <TextBlock Text="Administrator-preference undo requires the installed copy, administrator rights and the same Windows identity that made the change. Startup entries disabled by RMPCS have their own Restore action in Startup." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,14"/>
     <TextBlock x:Name="ProtectionStatus" Text="No protection action requested this session." TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="RESULTS &amp; ACTIVITY" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="Status" Grid.Row="1" Text="Choose a check to get started." FontSize="19" Margin="0,12,0,15" TextWrapping="Wrap"/>
    <TextBox x:Name="Activity" Grid.Row="2" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <StackPanel Grid.Row="3" Margin="0,12,0,0"><Expander x:Name="SummaryExpander" Header="Last manual run summary" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}"><TextBox x:Name="RunSummaryText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="210" Margin="0,8,0,10"/></Expander><ProgressBar x:Name="Progress" Height="4" Foreground="{DynamicResource AccentTextBrush}" Background="{DynamicResource RaisedBrush}" Visibility="Collapsed"/><TextBlock Text="Repairs finish before the queue stops. Overlapping maintenance sessions are blocked." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/></StackPanel>
   </Grid></Border>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,16,0,0"><Button x:Name="RunButton" Visibility="Collapsed" Content="Run selected tasks" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Click="Run_Click"/><Button x:Name="StopButton" Content="Stop after current task" IsEnabled="False" Click="Stop_Click"/><Button Content="Exit" Click="Exit_Click"/></WrapPanel>
 </Grid>
</Window>
