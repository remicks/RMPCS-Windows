<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>RMPCS</AssemblyName>
    <Version>0.13.5</Version><Product>RMPCS</Product><Description>Rusty's PC maintenance toolkit</Description>
    <ApplicationIcon>../Assets/RMPCS.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../RMPCS.Core/RMPCS.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="../Assets/RMPCS.ico" Link="Assets/RMPCS.ico" />
    <Resource Include="../Assets/RMPCS.png" Link="Assets/RMPCS.png" />
    <Resource Include="../Assets/Fonts/*.ttf" Link="Fonts/%(Filename)%(Extension)" />
    <Resource Include="../Assets/Fonts/OFL-*.txt" Link="FontLicenses/%(Filename)%(Extension)" />
    <Content Include="../Assets/Fonts/OFL-*.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../Assets/RMPCS.ico" Link="RMPCS.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
